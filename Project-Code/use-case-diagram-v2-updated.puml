@startuml Διάγραμμα Περιπτώσεων Χρήσης FitHub - Ενημερωμένη Έκδοση

left to right direction

' Styling
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor LightBlue
    BorderColor DarkBlue
    ArrowColor Black
}

' Actors
actor "Μέλος" as member
actor "Γυμναστής" as trainer
actor "Γραμματέας" as receptionist
actor "Διαχειριστής" as manager
actor "Ιδιοκτήτης" as owner
actor "Σύστημα AI" as ai <<system>>
actor "Πύλη Πληρωμών" as payment <<system>>
actor "Σύστημα Email" as email <<system>>

' System Boundary
rectangle "Σύστημα FitHub Gym CRM" {

    ' Use Case 1: Registration
    usecase "ΠΧ-1: Εγγραφή και\nΟδηγός Ενεργοποίησης" as UC1 #LightGreen
    usecase "Εγγραφή Μέλους" as UC1a
    usecase "Αίτηση Γυμναστή\n(Αποστολή CV & Εγγράφων)" as UC1b
    usecase "Εγγραφή Γραμματέα" as UC1c
    usecase "Διαχείριση Αιτήσεων Γυμναστών\n(Προβολή/Ενημέρωση Κατάστασης)" as UC1d
    usecase "Δημιουργία Σύμβασης Εργασίας" as UC1e
    usecase "Προβολή/Απόκριση σε Σύμβαση" as UC1f

    ' Use Case 2: Book Class
    usecase "ΠΧ-2: Κράτηση Μαθήματος" as UC2 #LightGreen
    usecase "Εγγραφή σε Λίστα Αναμονής" as UC2a
    usecase "Πληρωμή για Συνεδρία" as UC2b

    ' Use Case 3: Create Training Program
    usecase "ΠΧ-3: Δημιουργία Προσωπικού\nΣχεδίου Γυμναστικής" as UC3 #LightGreen
    usecase "Ομαδικό Πρόγραμμα" as UC3a
    usecase "Προσωπικό Πρόγραμμα" as UC3b

    ' Use Case 4: Assign Tasks
    usecase "ΠΧ-4: Ανάθεση Εργασιών\nστους Υπαλλήλους" as UC4 #LightGreen
    usecase "Ανακατανομή Εργασίας" as UC4a
    usecase "Ορισμός Προθεσμίας\n(Ημερολόγιο)" as UC4b
    usecase "Προβολή Εργασιών με\nΕιδοποιήσεις Κουδουνιού" as UC4c
    usecase "Σήμανση Κατάστασης Εργασίας\n(Σε Εξέλιξη/Ολοκληρωμένη)" as UC4d

    ' Use Case 5: Manage Discounts
    usecase "ΠΧ-5: Δημιουργία Καμπάνιας\nμε Κωδικό Προσφοράς" as UC5 #LightGreen
    usecase "Προεπισκόπηση Καμπάνιας" as UC5a
    usecase "Ορισμός Καναλιών Marketing\n(Εντός Εφαρμογής, Social Media)" as UC5b
    usecase "Επιβεβαίωση και Δημοσίευση" as UC5c

    ' Use Case 6: Track Campaign Stats
    usecase "ΠΧ-6: Παρακολούθηση Στατιστικών\nΚαμπάνιας" as UC6 #LightGreen
    usecase "Παρακολούθηση σε Πραγματικό Χρόνο" as UC6a
    usecase "Σύγκριση Καμπανιών" as UC6b
    usecase "Λήψη Αναφοράς" as UC6c

    ' Use Case 7: Apply Discount Code
    usecase "ΠΧ-7: Εφαρμογή Κωδικού Έκπτωσης" as UC7 #LightGreen
    usecase "Περιήγηση Διαθέσιμων Κωδικών" as UC7a
    usecase "Σφάλμα Μη Έγκυρου Κωδικού" as UC7b
    usecase "Σφάλμα Ληγμένου Κωδικού" as UC7c
    usecase "Προβολή Ανάλυσης Έκπτωσης" as UC7d

    ' Use Case 8: Track Client Progress
    usecase "ΠΧ-8: Παρακολούθηση Προόδου\nΠελάτη" as UC8 #LightGreen
    usecase "Προσθήκη Μετρήσεων" as UC8a
    usecase "Σφάλμα Συστήματος" as UC8b

    ' Use Case 9: Gym Evaluation
    usecase "ΠΧ-9: Αξιολόγηση Γυμναστηρίου" as UC9 #LightGreen
    usecase "Απόρριψη Αξιολόγησης" as UC9a

    ' Use Case 10: Customer Support
    usecase "ΠΧ-10: Σύστημα Υποστήριξης\nΠελατών" as UC10 #LightGreen
    usecase "Κλιμάκωση σε Άνθρωπο" as UC10a
    usecase "Σφάλμα Συστήματος AI" as UC10b
}

' Συνδέσεις ΠΧ-1
member --> UC1
trainer --> UC1
receptionist --> UC1

UC1 .> UC1a : <<include>>
UC1 .> UC1b : <<include>>
UC1 .> UC1c : <<include>>
UC1d .> UC1 : <<extend>>
UC1e .> UC1 : <<extend>>
UC1f .> UC1 : <<extend>>

payment --> UC1a
payment --> UC1b

receptionist --> UC1d
manager --> UC1d
owner --> UC1d

manager --> UC1e
owner --> UC1e

trainer --> UC1f

UC1e --> UC1f : <<triggers>>
email --> UC1e
email --> UC1f

' Συνδέσεις ΠΧ-2
member --> UC2

UC2a .> UC2 : <<extend>>
UC2b .> UC2 : <<extend>>

payment --> UC2b
receptionist --> UC2
trainer --> UC2

' Συνδέσεις ΠΧ-3
trainer --> UC3

UC3a .> UC3 : <<extend>>
UC3b .> UC3 : <<extend>>

' Συνδέσεις ΠΧ-4
manager --> UC4
owner --> UC4

UC4a .> UC4 : <<extend>>
UC4 .> UC4b : <<include>>
UC4c .> UC4 : <<extend>>
UC4d .> UC4 : <<extend>>

trainer --> UC4c
receptionist --> UC4c

UC4 --> UC4c : <<notifies>>

' Συνδέσεις ΠΧ-5
manager --> UC5
owner --> UC5

UC5 .> UC5a : <<include>>
UC5 .> UC5b : <<include>>
UC5 .> UC5c : <<include>>

' Συνδέσεις ΠΧ-6
manager --> UC6
owner --> UC6

UC6a .> UC6 : <<extend>>
UC6b .> UC6 : <<extend>>
UC6 .> UC6c : <<include>>

' Συνδέσεις ΠΧ-7
member --> UC7

UC7 .> UC7a : <<include>>
UC7b .> UC7 : <<extend>>
UC7c .> UC7 : <<extend>>
UC7 .> UC7d : <<include>>

payment --> UC7
email --> UC7

' Συνδέσεις ΠΧ-8
trainer --> UC8

UC8 .> UC8a : <<include>>
UC8b .> UC8 : <<extend>>

' Συνδέσεις ΠΧ-9
member --> UC9

UC9a .> UC9 : <<extend>>

trainer --> UC9
manager --> UC9

' Συνδέσεις ΠΧ-10
member --> UC10

UC10 .> UC10a : <<include>>
UC10a .> UC10 : <<extend>>
UC10b .> UC10 : <<extend>>

ai --> UC10
receptionist --> UC10a

@enduml
