@startuml Διάγραμμα Ευρωστίας ΠΧ-10: Σύστημα Υποστήριξης Πελατών

' Styling
skinparam actorStyle awesome
skinparam rectangle {
    BackgroundColor<<boundary>> LightYellow
    BackgroundColor<<control>> LightGreen
    BackgroundColor<<entity>> LightBlue
    BorderColor Black
}

' Actors
actor "Μέλος" as member
actor "Σύστημα AI" as ai
actor "Γραμματέας" as receptionist

' Boundary Objects (UI)
rectangle "Κουμπί Υποστήριξης" <<boundary>> as supportButton
rectangle "Επιλογή Κατηγορίας Θέματος" <<boundary>> as categorySelector
rectangle "Περιγραφή Προβλήματος" <<boundary>> as problemDescription
rectangle "Παράθυρο Chat" <<boundary>> as chatWindow
rectangle "Μήνυμα AI" <<boundary>> as aiMessage
rectangle "Μήνυμα Χρήστη" <<boundary>> as userMessage
rectangle "Κουμπί 'Κλιμάκωση σε Άνθρωπο'" <<boundary>> as escalateButton
rectangle "Κουμπί 'Κλείσιμο Ticket'" <<boundary>> as closeButton
rectangle "Μέτρηση Ικανοποίησης" <<boundary>> as satisfactionRating
rectangle "Πίνακας Tickets\n(Γραμματέας)" <<boundary>> as ticketDashboard
rectangle "Λεπτομέρειες Ticket" <<boundary>> as ticketDetails
rectangle "Μήνυμα Σφάλματος AI" <<boundary>> as aiErrorMsg

' Control Objects (Logic)
rectangle "Διαχειριστής Υποστήριξης" <<control>> as supportManager
rectangle "Επεξεργαστής AI" <<control>> as aiProcessor
rectangle "Ταξινομητής Θεμάτων" <<control>> as issueClassifier
rectangle "Διαχειριστής Κλιμάκωσης" <<control>> as escalationManager
rectangle "Μετρητής Μηνυμάτων" <<control>> as messageCounter
rectangle "Διαχειριστής Tickets" <<control>> as ticketManager

' Entity Objects (Data)
rectangle "Ticket Υποστήριξης" <<entity>> as ticket
rectangle "Κατηγορία Θέματος" <<entity>> as issueCategory
rectangle "Περιγραφή Προβλήματος" <<entity>> as issueProblem
rectangle "Ιστορικό Chat" <<entity>> as chatHistory
rectangle "Μήνυμα" <<entity>> as message
rectangle "Απάντηση AI" <<entity>> as aiResponse
rectangle "Κατάσταση Ticket" <<entity>> as ticketStatus
rectangle "Μετρητής Μηνυμάτων" <<entity>> as messageCount

' Ροή 1: Άνοιγμα Υποστήριξης
member --> supportButton : "1. Κλικ\n'Υποστήριξη'"
supportButton --> supportManager : "2. Έναρξη\nδιαδικασίας"
supportManager --> categorySelector : "3. Εμφανίζει\nκατηγορίες"

' Ροή 2: Επιλογή Κατηγορίας
categorySelector --> issueClassifier : "4. Φορτώνει\nκατηγορίες"
issueClassifier --> issueCategory : "5. Ανακτά:\n- Τεχνικά\n- Συνδρομή\n- Πληρωμή\n- Μαθήματα\n- Άλλο"
issueCategory --> categorySelector : "6. Εμφανίζει"
member --> categorySelector : "7. Επιλέγει\nκατηγορία"

' Ροή 3: Περιγραφή Προβλήματος
categorySelector --> problemDescription : "8. Ανοίγει\nπεδίο κειμένου"
member --> problemDescription : "9. Περιγράφει\nπρόβλημα"
problemDescription --> supportManager : "10. Υποβάλλει"

' Ροή 4: Δημιουργία Ticket
supportManager --> ticketManager : "11. Δημιουργία\nticket"
ticketManager --> ticket : "12. Δημιουργεί\nνέο ticket"
ticket --> issueCategory : "13. Συνδέει\nκατηγορία"
ticket --> issueProblem : "14. Αποθηκεύει\nπεριγραφή"
ticket --> ticketStatus : "15. Ορίζει:\n'Ανοιχτό'"

' Ροή 5: AI Chat Response
ticketManager --> chatWindow : "16. Ανοίγει\nchat"
chatWindow --> aiProcessor : "17. Ζητά\nαπάντηση AI"
aiProcessor --> ai : "18. Καλεί\nAI API"
ai --> aiProcessor : "19. Επιστρέφει\nαπάντηση"
aiProcessor --> aiResponse : "20. Αποθηκεύει"
aiResponse --> chatHistory : "21. Προσθέτει\nστο ιστορικό"
aiProcessor --> aiMessage : "22. Εμφανίζει"
aiMessage --> member : "23. Προβάλλει\nλύση/πληροφορίες"

' Ροή 6: Συνομιλία με AI
member --> chatWindow : "24. Απαντά"
chatWindow --> userMessage : "25. Εμφανίζει\nμήνυμα"
userMessage --> messageCounter : "26. Καταμέτρηση"
messageCounter --> messageCount : "27. Αυξάνει\nμετρητή"
userMessage --> aiProcessor : "28. Στέλνει\nστο AI"
aiProcessor --> ai : "29. Νέα\nαπάντηση"
ai --> aiProcessor : "30. Επιστροφή"
aiProcessor --> chatHistory : "31. Ενημέρωση\nιστορικού"

' Ροή 7: Κλιμάκωση σε Άνθρωπο (include)
messageCounter --> messageCount : "32. Ελέγχει\nαριθμό"
messageCount --> escalationManager : "33. Μετά από\n5 μηνύματα"
escalationManager --> escalateButton : "34. Εμφανίζει\nκουμπί"
member --> escalateButton : "35. Κλικ\n'Κλιμάκωση'"

' Ροή 8: Μεταφορά σε Γραμματέα
escalateButton --> escalationManager : "36. Ενεργοποίηση"
escalationManager --> ticketStatus : "37. Αλλάζει σε:\n'Αναμονή για\nΆνθρωπο'"
escalationManager --> receptionist : "38. Ειδοποίηση\nγραμματέα"

' Ροή 9: Γραμματέας Αναλαμβάνει
receptionist --> ticketDashboard : "39. Ανοίγει\ntickets"
ticketDashboard --> ticketManager : "40. Φορτώνει"
ticketManager --> ticket : "41. Ανακτά\nανοιχτά tickets"
ticket --> ticketDashboard : "42. Εμφανίζει\nλίστα"
receptionist --> ticketDashboard : "43. Επιλέγει\nticket"
ticketDashboard --> ticketDetails : "44. Εμφανίζει\nλεπτομέρειες"
ticketDetails --> chatHistory : "45. Φορτώνει\nιστορικό AI"
chatHistory --> ticketDetails : "46. Προβάλλει\nσυνομιλία"
receptionist --> chatWindow : "47. Αναλαμβάνει\nchat"
receptionist --> chatWindow : "48. Απαντά στο\nμέλος"

' Ροή 10a: Σφάλμα AI (extend)
ai --> aiProcessor : "49a. Σφάλμα\nσυστήματος"
aiProcessor --> aiErrorMsg : "50a. Μήνυμα"
aiErrorMsg --> member : "51a. 'Αποτυχία AI.\nΚλιμάκωση\nσε άνθρωπο'"
aiErrorMsg --> escalationManager : "52a. Αυτόματη\nκλιμάκωση"

' Ροή 11: Κλείσιμο Ticket
member --> chatWindow : "53. Λύθηκε\nτο πρόβλημα"
member --> closeButton : "54. Κλείσιμο"
closeButton --> ticketManager : "55. Ενημέρωση"
ticketManager --> ticketStatus : "56. Αλλάζει σε:\n'Κλειστό'"
ticketManager --> satisfactionRating : "57. Ζητά\nβαθμολογία"
member --> satisfactionRating : "58. Αξιολογεί\n(1-5 αστέρια)"
satisfactionRating --> ticket : "59. Αποθηκεύει\nβαθμολογία"

@enduml
