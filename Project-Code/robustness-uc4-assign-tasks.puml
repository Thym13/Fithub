@startuml Διάγραμμα Ευρωστίας ΠΧ-4: Ανάθεση Εργασιών στους Υπαλλήλους

' Styling
skinparam actorStyle awesome
skinparam rectangle {
    BackgroundColor<<boundary>> LightYellow
    BackgroundColor<<control>> LightGreen
    BackgroundColor<<entity>> LightBlue
    BorderColor Black
}

' Actors
actor "Διαχειριστής/Ιδιοκτήτης" as manager
actor "Υπάλληλος\n(Γυμναστής/Γραμματέας)" as employee
actor "Σύστημα Email" as email

' Boundary Objects (UI)
rectangle "Λίστα Υπαλλήλων" <<boundary>> as employeeList
rectangle "Φόρμα Δημιουργίας Εργασίας" <<boundary>> as taskForm
rectangle "Επιλογέας Ημερολογίου" <<boundary>> as calendarPicker
rectangle "Επιβεβαίωση Εργασίας" <<boundary>> as taskConfirmation
rectangle "Ειδοποίηση Κουδουνιού\n(Bell Notification)" <<boundary>> as bellNotification
rectangle "Καρτέλα 'Οι Εργασίες Μου'" <<boundary>> as myTasksTab
rectangle "Λεπτομέρειες Εργασίας" <<boundary>> as taskDetails
rectangle "Φόρμα Κατάστασης" <<boundary>> as statusForm
rectangle "Φόρμα Ανακατανομής" <<boundary>> as reassignForm
rectangle "Μήνυμα Επιτυχίας" <<boundary>> as successMsg

' Control Objects (Logic)
rectangle "Διαχειριστής Εργασιών" <<control>> as taskManager
rectangle "Επικυρωτής Εργασίας" <<control>> as taskValidator
rectangle "Διαχειριστής Ειδοποιήσεων" <<control>> as notificationManager
rectangle "Διαχειριστής Καταστάσεων" <<control>> as statusManager

' Entity Objects (Data)
rectangle "Εργασία" <<entity>> as task
rectangle "Υπάλληλος" <<entity>> as employeeEntity
rectangle "Ειδοποίηση" <<entity>> as notification
rectangle "Προθεσμία" <<entity>> as deadline
rectangle "Κατάσταση Εργασίας" <<entity>> as taskStatus
rectangle "Email" <<entity>> as emailEntity

' Ροή 1: Επιλογή Υπαλλήλου
manager --> employeeList : "1. Ανοίγει\nανάθεση εργασιών"
employeeList --> taskManager : "2. Φορτώνει\nυπαλλήλους"
taskManager --> employeeEntity : "3. Ανακτά λίστα"
employeeEntity --> employeeList : "4. Εμφανίζει"
manager --> employeeList : "5. Επιλέγει\nυπάλληλο"

' Ροή 2: Δημιουργία Εργασίας
employeeList --> taskForm : "6. Ανοίγει φόρμα"
manager --> taskForm : "7. Συμπληρώνει:\n- Τίτλο\n- Περιγραφή\n- Τύπο\n- Συχνότητα"

' Ροή 3: Ορισμός Προθεσμίας με Ημερολόγιο
taskForm --> calendarPicker : "8. Κλικ στο\nπεδίο προθεσμίας"
manager --> calendarPicker : "9. Επιλέγει\nημερομηνία"
calendarPicker --> taskManager : "10. Αποθηκεύει\nημερομηνία"
taskManager --> deadline : "11. Δημιουργεί\nπροθεσμία"

' Ροή 4: Επικύρωση και Αποθήκευση
manager --> taskForm : "12. Υποβάλλει"
taskForm --> taskValidator : "13. Επικύρωση"
taskValidator --> task : "14. Δημιουργεί\nεργασία"
task --> employeeEntity : "15. Συνδέει με\nυπάλληλο"

' Ροή 5: Αποστολή Ειδοποιήσεων
taskValidator --> notificationManager : "16. Ειδοποίηση\nυπαλλήλου"
notificationManager --> notification : "17. Δημιουργεί\nειδοποίηση"
notificationManager --> bellNotification : "18. Εμφανίζει\nκουδούνι"
bellNotification --> employee : "19a. Desktop:\nΚουδούνι στο\ntop bar"
bellNotification --> employee : "19b. Mobile:\nBadge δίπλα\nστο μενού"
notificationManager --> emailEntity : "20. Δημιουργεί email"
notificationManager --> email : "21. Στέλνει email"
taskValidator --> taskConfirmation : "22. Επιβεβαίωση"
taskConfirmation --> manager : "23. Εμφανίζει\nμήνυμα"

' Ροή 6: Προβολή Εργασιών από Υπάλληλο
employee --> bellNotification : "24. Κλικ στο\nκουδούνι"
bellNotification --> myTasksTab : "25. Ανακατεύθυνση\nστις εργασίες"
myTasksTab --> taskManager : "26. Φορτώνει\nεργασίες"
taskManager --> task : "27. Ανακτά\nεργασίες υπαλλήλου"
task --> myTasksTab : "28. Εμφανίζει\nλίστα"

' Ροή 7: Προβολή Λεπτομερειών
employee --> myTasksTab : "29. Επιλέγει\nεργασία"
myTasksTab --> taskDetails : "30. Εμφανίζει\nλεπτομέρειες"
taskDetails --> taskManager : "31. Φορτώνει info"
taskManager --> task : "32. Ανακτά\nδεδομένα"

' Ροή 8: Ενημέρωση Κατάστασης
employee --> taskDetails : "33. Επιλέγει\nκατάσταση"
taskDetails --> statusForm : "34. Εμφανίζει\nεπιλογές"
employee --> statusForm : "35. 'Σε Εξέλιξη' ή\n'Ολοκληρωμένη'"
statusForm --> statusManager : "36. Ενημερώνει"
statusManager --> taskStatus : "37. Αλλάζει\nκατάσταση"
statusManager --> task : "38. Ενημερώνει\nεργασία"
statusManager --> notificationManager : "39. Ειδοποίηση\nδιαχειριστή"
notificationManager --> manager : "40. Ενημέρωση\nολοκλήρωσης"
statusManager --> successMsg : "41. Επιτυχία"
successMsg --> employee : "42. Εμφανίζει\nμήνυμα"

' Ροή 9: Ανακατανομή Εργασίας (extend)
manager --> myTasksTab : "43. Ανοίγει\nεργασίες"
manager --> taskDetails : "44. Επιλέγει\nεργασία"
manager --> reassignForm : "45. Ανακατανομή"
reassignForm --> taskManager : "46. Φορτώνει\nάλλους υπαλλήλους"
taskManager --> employeeEntity : "47. Ανακτά λίστα"
manager --> reassignForm : "48. Επιλέγει\nνέο υπάλληλο"
reassignForm --> taskManager : "49. Ενημερώνει"
taskManager --> task : "50. Αλλάζει\nυπάλληλο"
taskManager --> notificationManager : "51. Ειδοποίηση\nνέου υπαλλήλου"

@enduml
