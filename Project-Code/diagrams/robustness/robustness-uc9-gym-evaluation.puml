@startuml Διάγραμμα Ευρωστίας ΠΧ-9: Αξιολόγηση Γυμναστηρίου

' Styling
skinparam actorStyle awesome
skinparam rectangle {
    BackgroundColor<<boundary>> LightYellow
    BackgroundColor<<control>> LightGreen
    BackgroundColor<<entity>> LightBlue
    BorderColor Black
}

' Actors
actor "Μέλος" as member
actor "Γυμναστής" as trainer
actor "Διαχειριστής" as manager

' Boundary Objects (UI)
rectangle "Περιοδική Προτροπή\nΑξιολόγησης" <<boundary>> as evaluationPrompt
rectangle "Επιλογή Δραστηριότητας" <<boundary>> as activitySelector
rectangle "Φόρμα Αξιολόγησης" <<boundary>> as evaluationForm
rectangle "Σύστημα 5 Αστέρων" <<boundary>> as starRating
rectangle "Πεδίο Σχολίων" <<boundary>> as commentsField
rectangle "Προεπισκόπηση Αξιολόγησης" <<boundary>> as reviewPreview
rectangle "Μήνυμα Επιτυχίας" <<boundary>> as successMsg
rectangle "Μήνυμα Απόρριψης" <<boundary>> as rejectionMsg
rectangle "Πίνακας Αξιολογήσεων\n(για Διαχειριστή)" <<boundary>> as reviewDashboard

' Control Objects (Logic)
rectangle "Διαχειριστής Αξιολογήσεων" <<control>> as reviewManager
rectangle "Επικυρωτής Αξιολόγησης" <<control>> as reviewValidator
rectangle "Φίλτρο Πολιτικής" <<control>> as policyFilter
rectangle "Υπολογιστής Βαθμολογίας" <<control>> as ratingCalculator
rectangle "Διαχειριστής Ειδοποιήσεων" <<control>> as notificationManager

' Entity Objects (Data)
rectangle "Αξιολόγηση" <<entity>> as evaluation
rectangle "Βαθμολογία (1-5)" <<entity>> as rating
rectangle "Σχόλια" <<entity>> as comments
rectangle "Δραστηριότητα" <<entity>> as activity
rectangle "Μάθημα" <<entity>> as class
rectangle "Γυμναστής" as trainerEntity <<entity>>
rectangle "Ειδοποίηση" <<entity>> as notification
rectangle "Κατάσταση Αξιολόγησης" <<entity>> as reviewStatus

' Ροή 1: Περιοδική Προτροπή
member --> evaluationPrompt : "1. Λαμβάνει\nπεριοδική προτροπή\n(μετά από μάθημα)"
evaluationPrompt --> reviewManager : "2. Έναρξη\nαξιολόγησης"

' Ροή 2: Επιλογή Πρόσφατης Δραστηριότητας
reviewManager --> activitySelector : "3. Εμφανίζει\nπρόσφατες\nδραστηριότητες"
activitySelector --> activity : "4. Φορτώνει\nιστορικό"
activity --> class : "5. Ανακτά\nμαθήματα"
class --> activitySelector : "6. Εμφανίζει\nλίστα"
member --> activitySelector : "7. Επιλέγει\nδραστηριότητα"

' Ροή 3: Συμπλήρωση Φόρμας
activitySelector --> evaluationForm : "8. Ανοίγει\nφόρμα"
evaluationForm --> starRating : "9. Εμφανίζει\nσύστημα αστέρων"
member --> starRating : "10. Επιλέγει\nβαθμολογία\n(1-5 αστέρια)"
starRating --> ratingCalculator : "11. Καταγράφει"
ratingCalculator --> rating : "12. Αποθηκεύει"

' Ροή 4: Προσθήκη Σχολίων
evaluationForm --> commentsField : "13. Εμφανίζει\nπεδίο κειμένου"
member --> commentsField : "14. Γράφει\nσχόλια"
commentsField --> reviewManager : "15. Αποθηκεύει\nκείμενο"

' Ροή 5: Προεπισκόπηση
member --> evaluationForm : "16. Κλικ\n'Προεπισκόπηση'"
evaluationForm --> reviewPreview : "17. Εμφανίζει\nπροεπισκόπηση"
reviewPreview --> member : "18. Προβάλλει:\n- Δραστηριότητα\n- Αστέρια\n- Σχόλια"

' Ροή 6: Υποβολή
member --> reviewPreview : "19. Υποβάλλει"
reviewPreview --> reviewValidator : "20. Επικύρωση"
reviewValidator --> policyFilter : "21. Έλεγχος\nπολιτικής"

' Ροή 7a: Παραβίαση Πολιτικής (extend)
policyFilter --> comments : "22a. Ελέγχει\nγια:\n- Προσβλητικό\nπεριεχόμενο\n- Spam\n- Ακατάλληλη\nγλώσσα"
comments --> policyFilter : "23a. Παραβίαση"
policyFilter --> reviewStatus : "24a. Απορρίπτει"
reviewStatus --> rejectionMsg : "25a. Μήνυμα"
rejectionMsg --> member : "26a. 'Η αξιολόγηση\nαπορρίφθηκε\nλόγω πολιτικής'"

' Ροή 7b: Έγκυρη Αξιολόγηση
comments --> policyFilter : "23b. Έγκυρο"
policyFilter --> reviewValidator : "24b. Επιτρέπει"
reviewValidator --> evaluation : "25b. Δημιουργεί\nαξιολόγηση"
evaluation --> rating : "26b. Συνδέει\nβαθμολογία"
evaluation --> comments : "27b. Συνδέει\nσχόλια"
evaluation --> activity : "28b. Συνδέει\nδραστηριότητα"

' Ροή 8: Ειδοποιήσεις
reviewValidator --> notificationManager : "29. Ειδοποίηση"
notificationManager --> notification : "30. Δημιουργεί"
notification --> trainerEntity : "31. Ειδοποιεί\nγυμναστή"
notification --> manager : "32. Ειδοποιεί\nδιαχειριστή"

' Ροή 9: Προβολή σε Διαχειριστή
manager --> reviewDashboard : "33. Ανοίγει\nαξιολογήσεις"
reviewDashboard --> reviewManager : "34. Φορτώνει"
reviewManager --> evaluation : "35. Ανακτά\nλίστα"
evaluation --> reviewDashboard : "36. Εμφανίζει\nόλες τις\nαξιολογήσεις"

' Ροή 10: Ενημέρωση Γυμναστή
trainer --> reviewDashboard : "37. Βλέπει\nαξιολογήσεις\nμαθημάτων του"
reviewDashboard --> ratingCalculator : "38. Υπολογισμός\nμέσου όρου"
ratingCalculator --> trainer : "39. Εμφανίζει\nμέσο όρο"

' Ροή 11: Επιτυχία
reviewValidator --> successMsg : "40. Επιτυχία"
successMsg --> member : "41. 'Ευχαριστούμε\nγια την αξιολόγηση!'"

@enduml
