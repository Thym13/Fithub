@startuml Διάγραμμα Ευρωστίας ΠΧ-1: Εγγραφή και Οδηγός Ενεργοποίησης

left to right direction

' Actors
actor "Χρήστης" as user
actor "Πύλη\nΠληρωμών" as payment
actor "Σύστημα\nEmail" as email
actor "Διαχειριστής" as admin

' Boundary Objects
boundary "Φόρμα\nΕπιλογής\nΡόλου" as roleForm
boundary "Φόρμα\nΕγγραφής" as regForm
boundary "Φόρμα\nΑνεβάσματος\nCV" as cvForm #red
boundary "Οθόνη\nΕπιβεβαίωσης\nEmail" as emailVerify
boundary "Οθόνη\nΠληρωμής" as paymentScreen
boundary "Πίνακας\nΑιτήσεων" as appList #red
boundary "Φόρμα\nΔημιουργίας\nΣύμβασης" as contractForm #red
boundary "Προεπισκόπηση\nΣύμβασης" as contractPreview #red
boundary "Προβολή\nΣύμβασης\nΓυμναστή" as trainerContractView #red
boundary "Μήνυμα\nΕπιτυχίας" as message

' Control Objects
control "Διαχειριστής\nΕγγραφής" as regController
control "Επικυρωτής\nEmail" as emailValidator
control "Επεξεργαστής\nΠληρωμής" as paymentProcessor
control "Διαχειριστής\nΕγκρίσεων" as approvalManager
control "Διαχειριστής\nΑιτήσεων" as appManager #red
control "Διαχειριστής\nΣυμβάσεων" as contractManager #red
control "Διαχειριστής\nΕιδοποιήσεων" as notificationManager

' Entity Objects
entity "Χρήστης" as userEntity
entity "Μέλος" as memberEntity
entity "Γυμναστής" as trainerEntity
entity "Γραμματέας" as recepEntity
entity "Αίτηση\nΓυμναστή" as trainerApp #red
entity "Έγγραφο\nCV" as cvDoc #red
entity "Πιστοποιητικά" as certDoc #red
entity "Σύμβαση\nΕργασίας" as contract #red
entity "Συναλλαγή" as transaction
entity "Email\nΕπιβεβαίωσης" as confirmEmail

' Main Flow
user --> roleForm
roleForm --> regController
regController --> regForm
user --> regForm
regForm --> regController
regController --> userEntity
regController --> emailValidator
emailValidator --> confirmEmail
emailValidator --> email
user --> emailVerify
emailVerify --> emailValidator
emailValidator --> userEntity

' Payment Flow
emailValidator --> paymentScreen
user --> paymentScreen
paymentScreen --> paymentProcessor
paymentProcessor --> payment
paymentProcessor --> transaction
paymentProcessor --> memberEntity

' Alternative: Trainer CV Upload (Red)
regForm -[#red]-> cvForm
user -[#red]-> cvForm
cvForm -[#red]-> regController
regController -[#red]-> cvDoc
regController -[#red]-> certDoc
regController -[#red]-> trainerApp

' Alternative: Manage Applications (Red)
admin -[#red]-> appList
appList -[#red]-> appManager
appManager -[#red]-> trainerApp
appManager -[#red]-> cvDoc
appManager -[#red]-> certDoc

' Alternative: Contract Creation (Red)
admin -[#red]-> contractForm
contractForm -[#red]-> contractManager
contractManager -[#red]-> contractPreview
admin -[#red]-> contractPreview
contractManager -[#red]-> contract
contractManager -[#red]-> notificationManager
notificationManager -[#red]-> email

' Alternative: Trainer Contract Response (Red)
user -[#red]-> trainerContractView
trainerContractView -[#red]-> contractManager
contractManager -[#red]-> contract
contractManager -[#red]-> notificationManager

' Approval & Completion
contractManager --> approvalManager
approvalManager --> userEntity
approvalManager --> trainerEntity
approvalManager --> message
message --> user

@enduml
