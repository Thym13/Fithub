@startuml Διάγραμμα Ευρωστίας ΠΧ-2: Κράτηση Μαθήματος

' Styling
skinparam actorStyle awesome
skinparam rectangle {
    BackgroundColor<<boundary>> LightYellow
    BackgroundColor<<control>> LightGreen
    BackgroundColor<<entity>> LightBlue
    BorderColor Black
}

' Actors
actor "Μέλος" as member
actor "Γραμματέας" as receptionist
actor "Γυμναστής" as trainer
actor "Πύλη Πληρωμών" as payment

' Boundary Objects (UI)
rectangle "Κατάλογος Μαθημάτων" <<boundary>> as classList
rectangle "Λεπτομέρειες Μαθήματος" <<boundary>> as classDetails
rectangle "Φόρμα Κράτησης" <<boundary>> as bookingForm
rectangle "Λίστα Αναμονής" <<boundary>> as waitlistScreen
rectangle "Οθόνη Πληρωμής Συνεδρίας" <<boundary>> as sessionPayment
rectangle "Επιβεβαίωση Κράτησης" <<boundary>> as confirmation
rectangle "Μήνυμα Σφάλματος" <<boundary>> as errorMsg

' Control Objects (Logic)
rectangle "Διαχειριστής Μαθημάτων" <<control>> as classManager
rectangle "Επικυρωτής Κράτησης" <<control>> as bookingValidator
rectangle "Έλεγχος Συνδρομής" <<control>> as subscriptionChecker
rectangle "Διαχειριστής Λίστας Αναμονής" <<control>> as waitlistManager
rectangle "Επεξεργαστής Πληρωμής" <<control>> as paymentProcessor
rectangle "Διαχειριστής Ειδοποιήσεων" <<control>> as notificationManager

' Entity Objects (Data)
rectangle "Μάθημα" <<entity>> as classEntity
rectangle "Κράτηση" <<entity>> as booking
rectangle "Μέλος" <<entity>> as memberEntity
rectangle "Συνδρομή" <<entity>> as subscription
rectangle "Λίστα Αναμονής" <<entity>> as waitlist
rectangle "Συναλλαγή" <<entity>> as transaction
rectangle "Ειδοποίηση" <<entity>> as notification

' Ροή 1: Προβολή Διαθέσιμων Μαθημάτων
member --> classList : "1. Ανοίγει\nμαθήματα"
classList --> classManager : "2. Ζητά διαθέσιμα"
classManager --> classEntity : "3. Ανακτά λίστα"
classEntity --> classList : "4. Εμφανίζει\n(ημερομηνία, ώρα,\nδιαθεσιμότητα)"

' Ροή 2: Επιλογή Μαθήματος
member --> classList : "5. Επιλέγει μάθημα"
classList --> classDetails : "6. Εμφανίζει\nλεπτομέρειες"
classDetails --> classManager : "7. Φορτώνει info"
classManager --> classEntity : "8. Ανακτά\nδεδομένα"

' Ροή 3: Έλεγχος Συνδρομής
member --> classDetails : "9. Κάνει κλικ\n'Κράτηση'"
classDetails --> bookingValidator : "10. Έναρξη\nκράτησης"
bookingValidator --> subscriptionChecker : "11. Έλεγχος\nσυνδρομής"
subscriptionChecker --> memberEntity : "12. Ανακτά μέλος"
memberEntity --> subscriptionChecker : "13. Επιστρέφει\nδεδομένα"
subscriptionChecker --> subscription : "14. Ελέγχει\nενεργή συνδρομή"

' Ροή 4: Κράτηση με Συνδρομή
subscription --> subscriptionChecker : "15a. Έγκυρη\nσυνδρομή"
subscriptionChecker --> bookingValidator : "16a. Επιτρέπει"
bookingValidator --> classEntity : "17a. Ελέγχει\nδιαθεσιμότητα"
classEntity --> bookingValidator : "18a. Θέσεις\nδιαθέσιμες"
bookingValidator --> booking : "19a. Δημιουργεί\nκράτηση"
booking --> classEntity : "20a. Ενημερώνει\nθέσεις"
bookingValidator --> notificationManager : "21a. Ειδοποίηση"
notificationManager --> notification : "22a. Δημιουργεί"
notificationManager --> receptionist : "23a. Ενημερώνει\nγραμματέα"
notificationManager --> trainer : "24a. Ενημερώνει\nγυμναστή"
bookingValidator --> confirmation : "25a. Επιτυχία"
confirmation --> member : "26a. Εμφανίζει\nμήνυμα"

' Ροή 5: Εγγραφή σε Λίστα Αναμονής (extend)
classEntity --> bookingValidator : "18b. Μάθημα\nγεμάτο"
bookingValidator --> waitlistScreen : "19b. Προτείνει\nλίστα αναμονής"
member --> waitlistScreen : "20b. Αποδέχεται"
waitlistScreen --> waitlistManager : "21b. Εγγραφή"
waitlistManager --> waitlist : "22b. Προσθήκη\nμέλους"
waitlistManager --> confirmation : "23b. Επιβεβαίωση"
confirmation --> member : "24b. Μήνυμα\nεγγραφής"

' Ροή 6: Πληρωμή για Συνεδρία (extend - χωρίς συνδρομή)
subscription --> subscriptionChecker : "15c. Δεν υπάρχει\nσυνδρομή"
subscriptionChecker --> sessionPayment : "16c. Προσφέρει\nπληρωμή"
member --> sessionPayment : "17c. Αποδέχεται\nπληρωμή"
sessionPayment --> paymentProcessor : "18c. Επεξεργασία"
paymentProcessor --> payment : "19c. Καλεί API"
payment --> paymentProcessor : "20c. Επιτυχία"
paymentProcessor --> transaction : "21c. Καταγράφει"
paymentProcessor --> bookingValidator : "22c. Συνεχίζει\nκράτηση"
bookingValidator --> booking : "23c. Δημιουργεί\nκράτηση"
bookingValidator --> confirmation : "24c. Επιβεβαίωση"

' Ροή 7: Σφάλμα
classEntity --> bookingValidator : "18d. Μάθημα\nακυρωμένο"
bookingValidator --> errorMsg : "19d. Σφάλμα"
errorMsg --> member : "20d. Εμφανίζει\nμήνυμα"

@enduml
