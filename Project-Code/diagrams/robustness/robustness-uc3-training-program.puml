@startuml Διάγραμμα Ευρωστίας ΠΧ-3: Δημιουργία Προσωπικού Σχεδίου Γυμναστικής

' Styling
skinparam actorStyle awesome
skinparam rectangle {
    BackgroundColor<<boundary>> LightYellow
    BackgroundColor<<control>> LightGreen
    BackgroundColor<<entity>> LightBlue
    BorderColor Black
}

' Actors
actor "Γυμναστής" as trainer

' Boundary Objects (UI)
rectangle "Επιλογή Τύπου Προγράμματος" <<boundary>> as typeSelection
rectangle "Επιλογή Πελάτη/Ομάδας" <<boundary>> as clientSelection
rectangle "Φόρμα Στόχων" <<boundary>> as goalsForm
rectangle "Επιλογή Δυσκολίας" <<boundary>> as difficultySelector
rectangle "Βιβλιοθήκη Ασκήσεων" <<boundary>> as exerciseLibrary
rectangle "Φόρμα Άσκησης" <<boundary>> as exerciseForm
rectangle "Προεπισκόπηση Προγράμματος" <<boundary>> as programPreview
rectangle "Επιβεβαίωση" <<boundary>> as confirmation
rectangle "Μήνυμα Επιτυχίας" <<boundary>> as successMsg

' Control Objects (Logic)
rectangle "Διαχειριστής Προγραμμάτων" <<control>> as programManager
rectangle "Επικυρωτής Προγράμματος" <<control>> as programValidator
rectangle "Διαχειριστής Ασκήσεων" <<control>> as exerciseManager
rectangle "Υπολογιστής Δυσκολίας" <<control>> as difficultyCalculator

' Entity Objects (Data)
rectangle "Πρόγραμμα Γυμναστικής" <<entity>> as trainingProgram
rectangle "Ομαδικό Πρόγραμμα" <<entity>> as groupProgram
rectangle "Προσωπικό Πρόγραμμα" <<entity>> as personalProgram
rectangle "Άσκηση" <<entity>> as exercise
rectangle "Σετ Ασκήσεων" <<entity>> as exerciseSet
rectangle "Πελάτης" <<entity>> as client
rectangle "Ομάδα" <<entity>> as group
rectangle "Στόχοι" <<entity>> as goals
rectangle "Επίπεδο Δυσκολίας" <<entity>> as difficulty

' Ροή 1: Επιλογή Τύπου Προγράμματος
trainer --> typeSelection : "1. Ανοίγει\nδημιουργία"
typeSelection --> programManager : "2. Επιλέγει\nτύπο"
trainer --> typeSelection : "3. Ομαδικό ή\nΠροσωπικό"

' Ροή 2a: Προσωπικό Πρόγραμμα
typeSelection --> clientSelection : "4a. Προσωπικό"
clientSelection --> programManager : "5a. Φορτώνει\nπελάτες"
programManager --> client : "6a. Ανακτά λίστα"
client --> clientSelection : "7a. Εμφανίζει"
trainer --> clientSelection : "8a. Επιλέγει\nπελάτη"
clientSelection --> programManager : "9a. Αποθηκεύει\nεπιλογή"

' Ροή 2b: Ομαδικό Πρόγραμμα
typeSelection --> clientSelection : "4b. Ομαδικό"
clientSelection --> programManager : "5b. Φορτώνει\nομάδες"
programManager --> group : "6b. Ανακτά λίστα"
group --> clientSelection : "7b. Εμφανίζει"
trainer --> clientSelection : "8b. Επιλέγει\nομάδα"

' Ροή 3: Ορισμός Στόχων
programManager --> goalsForm : "10. Εμφανίζει\nφόρμα"
trainer --> goalsForm : "11. Ορίζει στόχους\n(απώλεια βάρους,\nμυϊκή μάζα, κτλ)"
goalsForm --> programManager : "12. Αποθηκεύει"
programManager --> goals : "13. Δημιουργεί\nστόχους"

' Ροή 4: Επιλογή Δυσκολίας
programManager --> difficultySelector : "14. Εμφανίζει\nεπίπεδα"
trainer --> difficultySelector : "15. Επιλέγει\nδυσκολία"
difficultySelector --> difficultyCalculator : "16. Υπολογισμός"
difficultyCalculator --> difficulty : "17. Ορίζει"

' Ροή 5: Προσθήκη Ασκήσεων
programManager --> exerciseLibrary : "18. Εμφανίζει\nβιβλιοθήκη"
exerciseLibrary --> exerciseManager : "19. Φορτώνει"
exerciseManager --> exercise : "20. Ανακτά\nασκήσεις"
exercise --> exerciseLibrary : "21. Εμφανίζει\nκατηγορίες"
trainer --> exerciseLibrary : "22. Επιλέγει\nάσκηση"
exerciseLibrary --> exerciseForm : "23. Ανοίγει\nφόρμα"

' Ροή 6: Ορισμός Σετ και Επαναλήψεων
trainer --> exerciseForm : "24. Ορίζει:\n- Σετ\n- Επαναλήψεις\n- Βάρος\n- Διάρκεια"
exerciseForm --> exerciseManager : "25. Αποθηκεύει"
exerciseManager --> exerciseSet : "26. Δημιουργεί σετ"
exerciseManager --> trainingProgram : "27. Προσθέτει\nστο πρόγραμμα"

' Ροή 7: Επανάληψη για περισσότερες ασκήσεις
trainer --> exerciseLibrary : "28. Προσθέτει\nάλλες ασκήσεις"
exerciseLibrary --> exerciseForm : "29. Επαναλαμβάνει\n22-27"

' Ροή 8: Προεπισκόπηση
trainer --> exerciseLibrary : "30. Ολοκλήρωση"
exerciseLibrary --> programValidator : "31. Επικύρωση"
programValidator --> trainingProgram : "32. Ελέγχει\nπληρότητα"
trainingProgram --> programValidator : "33. Έγκυρο"
programValidator --> programPreview : "34. Εμφανίζει\nπροεπισκόπηση"

' Ροή 9: Αποθήκευση
trainer --> programPreview : "35. Επιβεβαιώνει"
programPreview --> programManager : "36. Αποθηκεύει"
programManager --> personalProgram : "37a. Αποθήκευση\nπροσωπικού"
programManager --> groupProgram : "37b. Αποθήκευση\nομαδικού"
programManager --> client : "38a. Συνδέει\nμε πελάτη"
programManager --> group : "38b. Συνδέει\nμε ομάδα"
programManager --> successMsg : "39. Επιτυχία"
successMsg --> trainer : "40. Εμφανίζει\nμήνυμα"

@enduml
