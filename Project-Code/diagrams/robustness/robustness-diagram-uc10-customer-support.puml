@startuml Διάγραμμα Ευρωστίας ΠΧ-10: Σύστημα Υποστήριξης Πελατών

left to right direction

' Actors
actor "Μέλος" as member
actor "Σύστημα\nAI" as ai
actor "Γραμματέας" as receptionist

' Boundary Objects
boundary "Κουμπί\nΥποστήριξης" as supportButton
boundary "Επιλογέας\nΚατηγορίας" as categorySelector
boundary "Περιγραφή\nΠροβλήματος" as problemDescription
boundary "Παράθυρο\nΣυνομιλίας" as chatWindow
boundary "Μήνυμα\nAI" as aiMessage
boundary "Μήνυμα\nΧρήστη" as userMessage
boundary "Κουμπί\nΚλιμάκωσης" as escalateButton #red
boundary "Κουμπί\nΚλεισίματος" as closeButton
boundary "Βαθμολογία\nΙκανοποίησης" as satisfactionRating
boundary "Πίνακας\nΑιτημάτων" as ticketDashboard
boundary "Λεπτομέρειες\nΑιτήματος" as ticketDetails
boundary "Μήνυμα\nΣφάλματος\nAI" as aiErrorMsg #red

' Control Objects
control "Διαχειριστής\nΥποστήριξης" as supportManager
control "Επεξεργαστής\nAI" as aiProcessor
control "Ταξινομητής\nΖητημάτων" as issueClassifier
control "Διαχειριστής\nΚλιμάκωσης" as escalationManager #red
control "Μετρητής\nΜηνυμάτων" as messageCounter
control "Διαχειριστής\nΑιτημάτων" as ticketManager

' Entity Objects
entity "Αίτημα\nΥποστήριξης" as ticket
entity "Κατηγορία\nΖητήματος" as issueCategory
entity "Πρόβλημα\nΖητήματος" as issueProblem
entity "Ιστορικό\nΣυνομιλίας" as chatHistory
entity "Μήνυμα" as message
entity "Απάντηση\nAI" as aiResponse
entity "Κατάσταση\nΑιτήματος" as ticketStatus
entity "Αριθμός\nΜηνυμάτων" as messageCount

' Main Flow
member --> supportButton
supportButton --> supportManager
supportManager --> categorySelector
categorySelector --> issueClassifier
issueClassifier --> issueCategory
member --> categorySelector
categorySelector --> problemDescription
member --> problemDescription
problemDescription --> supportManager
supportManager --> ticketManager
ticketManager --> ticket
ticket --> issueCategory
ticket --> issueProblem
ticket --> ticketStatus
ticketManager --> chatWindow
chatWindow --> aiProcessor
aiProcessor --> ai
aiProcessor --> aiResponse
aiResponse --> chatHistory
aiProcessor --> aiMessage
aiMessage --> member
member --> chatWindow
chatWindow --> userMessage
userMessage --> messageCounter
messageCounter --> messageCount
userMessage --> aiProcessor
aiProcessor --> chatHistory
member --> closeButton
closeButton --> ticketManager
ticketManager --> ticketStatus
ticketManager --> satisfactionRating
member --> satisfactionRating
satisfactionRating --> ticket

' Alternative: Escalate to Human (Red)
messageCounter -[#red]-> escalationManager
escalationManager -[#red]-> escalateButton
member -[#red]-> escalateButton
escalateButton -[#red]-> escalationManager
escalationManager -[#red]-> ticketStatus
escalationManager -[#red]-> receptionist
receptionist -[#red]-> ticketDashboard
ticketDashboard -[#red]-> ticketManager
ticketManager -[#red]-> ticket
ticketDashboard -[#red]-> ticketDetails
ticketDetails -[#red]-> chatHistory
receptionist -[#red]-> chatWindow

' Alternative: AI Error (Red)
ai -[#red]-> aiErrorMsg
aiErrorMsg -[#red]-> member
aiErrorMsg -[#red]-> escalationManager

@enduml
