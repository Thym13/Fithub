@startuml Διάγραμμα Ευρωστίας ΠΧ-1: Εγγραφή και Οδηγός Ενεργοποίησης

' Styling
skinparam actorStyle awesome
skinparam rectangle {
    BackgroundColor<<boundary>> LightYellow
    BackgroundColor<<control>> LightGreen
    BackgroundColor<<entity>> LightBlue
    BorderColor Black
}

' Actor
actor "Χρήστης\n(Μέλος/Γυμναστής/Γραμματέας)" as user
actor "Πύλη Πληρωμών" as payment
actor "Σύστημα Email" as email
actor "Διαχειριστής/Ιδιοκτήτης" as admin

' Boundary Objects (UI)
rectangle "Φόρμα Επιλογής Ρόλου" <<boundary>> as roleForm
rectangle "Φόρμα Εγγραφής" <<boundary>> as regForm
rectangle "Φόρμα Ανεβάσματος CV\n(για Γυμναστή)" <<boundary>> as cvForm
rectangle "Οθόνη Επιβεβαίωσης Email" <<boundary>> as emailVerify
rectangle "Οθόνη Πληρωμής" <<boundary>> as paymentScreen
rectangle "Πίνακας Αιτήσεων Γυμναστών" <<boundary>> as appList
rectangle "Φόρμα Δημιουργίας Σύμβασης" <<boundary>> as contractForm
rectangle "Προεπισκόπηση Σύμβασης" <<boundary>> as contractPreview
rectangle "Οθόνη Προβολής Σύμβασης\n(Γυμναστής)" <<boundary>> as trainerContractView
rectangle "Μήνυμα Επιτυχίας/Σφάλματος" <<boundary>> as message

' Control Objects (Logic)
rectangle "Διαχειριστής Εγγραφής" <<control>> as regController
rectangle "Επικυρωτής Email" <<control>> as emailValidator
rectangle "Επεξεργαστής Πληρωμής" <<control>> as paymentProcessor
rectangle "Διαχειριστής Εγκρίσεων" <<control>> as approvalManager
rectangle "Διαχειριστής Αιτήσεων" <<control>> as appManager
rectangle "Διαχειριστής Συμβάσεων" <<control>> as contractManager
rectangle "Διαχειριστής Ειδοποιήσεων" <<control>> as notificationManager

' Entity Objects (Data)
rectangle "Χρήστης" <<entity>> as userEntity
rectangle "Μέλος" <<entity>> as memberEntity
rectangle "Γυμναστής" <<entity>> as trainerEntity
rectangle "Γραμματέας" <<entity>> as recepEntity
rectangle "Αίτηση Γυμναστή" <<entity>> as trainerApp
rectangle "Έγγραφο CV" <<entity>> as cvDoc
rectangle "Πιστοποιητικά" <<entity>> as certDoc
rectangle "Σύμβαση Εργασίας" <<entity>> as contract
rectangle "Συναλλαγή Πληρωμής" <<entity>> as transaction
rectangle "Email Επιβεβαίωσης" <<entity>> as confirmEmail

' Ροή 1: Βασική Εγγραφή
user --> roleForm : "1. Επιλέγει ρόλο"
roleForm --> regController : "2. Υποβάλλει επιλογή"
regController --> regForm : "3. Εμφανίζει φόρμα\nανάλογα με ρόλο"
user --> regForm : "4. Συμπληρώνει στοιχεία"

' Ροή 2: Αίτηση Γυμναστή με CV
regForm --> cvForm : "5a. Αν Γυμναστής:\nΕμφανίζει upload"
user --> cvForm : "6a. Ανεβάζει CV\nκαι πιστοποιητικά"
cvForm --> regController : "7a. Αποστέλλει αρχεία"
regController --> cvDoc : "8a. Αποθηκεύει CV"
regController --> certDoc : "8b. Αποθηκεύει\nπιστοποιητικά"
regController --> trainerApp : "8c. Δημιουργεί αίτηση"

' Ροή 3: Email Verification
regForm --> regController : "5b. Υποβάλλει φόρμα"
regController --> userEntity : "9. Δημιουργεί χρήστη"
regController --> emailValidator : "10. Ζητά επικύρωση"
emailValidator --> confirmEmail : "11. Δημιουργεί email"
email <-- emailValidator : "12. Στέλνει email"
user --> emailVerify : "13. Κάνει κλικ στο link"
emailVerify --> emailValidator : "14. Επιβεβαιώνει"
emailValidator --> userEntity : "15. Ενημερώνει status"

' Ροή 4: Πληρωμή
emailValidator --> paymentScreen : "16. Ανακατεύθυνση\nσε πληρωμή"
user --> paymentScreen : "17. Εισάγει στοιχεία\nπληρωμής"
paymentScreen --> paymentProcessor : "18. Επεξεργασία"
paymentProcessor --> payment : "19. Καλεί API"
payment --> paymentProcessor : "20. Επιστρέφει\nαποτέλεσμα"
paymentProcessor --> transaction : "21. Καταγράφει\nσυναλλαγή"
paymentProcessor --> memberEntity : "22. Ενημερώνει\nσυνδρομή"

' Ροή 5: Διαχείριση Αιτήσεων (για Γυμναστές)
admin --> appList : "23. Ανοίγει\nΑιτήσεις"
appList --> appManager : "24. Ζητά λίστα"
appManager --> trainerApp : "25. Ανακτά αιτήσεις"
trainerApp --> appList : "26. Εμφανίζει"
admin --> appList : "27. Επιλέγει αίτηση"
appList --> appManager : "28. Προβάλλει\nλεπτομέρειες"
appManager --> cvDoc : "29. Φορτώνει CV"
appManager --> certDoc : "30. Φορτώνει\nπιστοποιητικά"
admin --> appList : "31. Ενημερώνει\nκατάσταση"
appList --> appManager : "32. Αποθηκεύει"
appManager --> trainerApp : "33. Ενημερώνει status"

' Ροή 6: Δημιουργία Σύμβασης
admin --> contractForm : "34. Δημιουργία\nσύμβασης"
admin --> contractForm : "35. Συμπληρώνει\nόρους"
contractForm --> contractManager : "36. Επικύρωση"
contractManager --> contractPreview : "37. Προεπισκόπηση"
admin --> contractPreview : "38. Επιβεβαιώνει"
contractPreview --> contractManager : "39. Αποθηκεύει"
contractManager --> contract : "40. Δημιουργεί\nσύμβαση"
contractManager --> notificationManager : "41. Ειδοποίηση"
notificationManager --> email : "42. Στέλνει email"

' Ροή 7: Απόκριση Γυμναστή σε Σύμβαση
user --> trainerContractView : "43. Ανοίγει\nσύμβαση"
trainerContractView --> contractManager : "44. Φορτώνει\nλεπτομέρειες"
contractManager --> contract : "45. Ανακτά\nσύμβαση"
contract --> trainerContractView : "46. Εμφανίζει"
user --> trainerContractView : "47. Αποδέχεται/\nΑπορρίπτει"
trainerContractView --> contractManager : "48. Ενημερώνει"
contractManager --> contract : "49. Αλλάζει status"
contractManager --> notificationManager : "50. Ειδοποίηση\nδιαχειριστή"

' Ροή 8: Έγκριση Διαχειριστή
contractManager --> approvalManager : "51. Ζητά έγκριση"
approvalManager --> userEntity : "52. Ενεργοποιεί\nλογαριασμό"
approvalManager --> trainerEntity : "53. Δημιουργεί\nprofile γυμναστή"
approvalManager --> message : "54. Επιτυχία"
message --> user : "55. Εμφανίζει\nμήνυμα"

@enduml
