@startuml Διάγραμμα Ευρωστίας ΠΧ-4: Ανάθεση Εργασιών στους Υπαλλήλους

left to right direction

' Actors
actor "Διαχειριστής" as manager
actor "Υπάλληλος" as employee
actor "Σύστημα\nEmail" as email

' Boundary Objects
boundary "Λίστα\nΥπαλλήλων" as employeeList
boundary "Φόρμα\nΔημιουργίας\nΕργασίας" as taskForm
boundary "Επιλογέας\nΗμερολογίου" as calendarPicker
boundary "Επιβεβαίωση\nΕργασίας" as taskConfirmation
boundary "Ειδοποίηση\nΚαμπάνας" as bellNotification
boundary "Καρτέλα\nΕργασιών μου" as myTasksTab
boundary "Λεπτομέρειες\nΕργασίας" as taskDetails
boundary "Φόρμα\nΚατάστασης" as statusForm
boundary "Φόρμα\nΑναπροώθησης" as reassignForm #red
boundary "Μήνυμα\nΕπιτυχίας" as successMsg

' Control Objects
control "Διαχειριστής\nΕργασιών" as taskManager
control "Επικυρωτής\nΕργασιών" as taskValidator
control "Διαχειριστής\nΕιδοποιήσεων" as notificationManager
control "Διαχειριστής\nΚατάστασης" as statusManager

' Entity Objects
entity "Εργασία" as task
entity "Υπάλληλος" as employeeEntity
entity "Ειδοποίηση" as notification
entity "Προθεσμία" as deadline
entity "Κατάσταση\nΕργασίας" as taskStatus
entity "Email" as emailEntity

' Main Flow
manager --> employeeList
employeeList --> taskManager
taskManager --> employeeEntity
manager --> taskForm
taskForm --> calendarPicker
manager --> calendarPicker
calendarPicker --> taskManager
taskManager --> deadline
taskForm --> taskValidator
taskValidator --> task
task --> employeeEntity
taskValidator --> notificationManager
notificationManager --> notification
notificationManager --> bellNotification
bellNotification --> employee
notificationManager --> emailEntity
notificationManager --> email
taskValidator --> taskConfirmation
taskConfirmation --> manager

' Employee Views Tasks
employee --> bellNotification
bellNotification --> myTasksTab
myTasksTab --> taskManager
taskManager --> task
employee --> taskDetails
taskDetails --> taskManager
employee --> statusForm
statusForm --> statusManager
statusManager --> taskStatus
statusManager --> task
statusManager --> notificationManager
notificationManager --> manager
statusManager --> successMsg
successMsg --> employee

' Alternative: Reassign Task (Red)
manager -[#red]-> reassignForm
reassignForm -[#red]-> taskManager
taskManager -[#red]-> employeeEntity
taskManager -[#red]-> notificationManager

@enduml
