@startuml Διάγραμμα Ευρωστίας ΠΧ-8: Παρακολούθηση Προόδου Πελάτη

left to right direction

' Actors
actor "Γυμναστής" as trainer

' Boundary Objects
boundary "Λίστα\nΠελατών" as clientList
boundary "Προφίλ\nΠελάτη" as clientProfile
boundary "Ιστορικό\nΠροόδου" as progressHistory
boundary "Γράφημα\nΠροόδου" as progressChart
boundary "Φόρμα\nΜετρήσεων" as measurementForm
boundary "Φόρμα\nΣτόχων" as goalsForm
boundary "Προβολή\nΣύγκρισης" as comparisonView
boundary "Μήνυμα\nΕπιτυχίας" as successMsg
boundary "Μήνυμα\nΣφάλματος" as errorMsg #red

' Control Objects
control "Διαχειριστής\nΠελατών" as clientManager
control "Διαχειριστής\nΠροόδου" as progressManager
control "Επικυρωτής\nΜετρήσεων" as measurementValidator
control "Υπολογιστής\nΣτατιστικών" as statsCalculator
control "Διαχειριστής\nΣτόχων" as goalsManager
control "Διαχειριστής\nΕιδοποιήσεων" as notificationManager

' Entity Objects
entity "Πελάτης" as client
entity "Μέτρηση" as measurement
entity "Βάρος\n(kg)" as weight
entity "Ύψος\n(cm)" as height
entity "Μέση\n(cm)" as waist
entity "Μυϊκή\nΜάζα" as muscleMass
entity "Λίπος\n(%)" as bodyFat
entity "Ιστορικό\nΜετρήσεων" as measurementHistory
entity "Στόχοι" as goals
entity "Ειδοποίηση" as notification

' Main Flow
trainer --> clientList
clientList --> clientManager
clientManager --> client
trainer --> clientProfile
clientProfile --> progressManager
progressManager --> measurementHistory
measurementHistory --> progressHistory
progressManager --> statsCalculator
statsCalculator --> weight
statsCalculator --> bodyFat
statsCalculator --> muscleMass
statsCalculator --> progressChart
progressChart --> trainer
trainer --> measurementForm
measurementForm --> measurementValidator
measurementValidator --> measurement
measurementValidator --> progressManager
progressManager --> weight
progressManager --> height
progressManager --> waist
progressManager --> muscleMass
progressManager --> bodyFat
progressManager --> measurementHistory
progressManager --> statsCalculator
statsCalculator --> comparisonView
comparisonView --> trainer
trainer --> goalsForm
goalsForm --> goalsManager
goalsManager --> goals
progressManager --> notificationManager
notificationManager --> notification
notification --> client
progressManager --> successMsg
successMsg --> trainer

' Alternative: System Error (Red)
measurementValidator -[#red]-> errorMsg
errorMsg -[#red]-> trainer

@enduml
