@startuml Διάγραμμα Ευρωστίας ΠΧ-5: Δημιουργία Καμπάνιας με Κωδικό Προσφοράς

' Styling
skinparam actorStyle awesome
skinparam rectangle {
    BackgroundColor<<boundary>> LightYellow
    BackgroundColor<<control>> LightGreen
    BackgroundColor<<entity>> LightBlue
    BorderColor Black
}

' Actors
actor "Διαχειριστής/Ιδιοκτήτης" as manager
actor "Μέλος" as member

' Boundary Objects (UI)
rectangle "Πίνακας Καμπανιών" <<boundary>> as campaignDashboard
rectangle "Φόρμα Δημιουργίας Καμπάνιας" <<boundary>> as campaignForm
rectangle "Γεννήτρια Κωδικού Προσφοράς" <<boundary>> as promoCodeGenerator
rectangle "Επιλογέας Ημερολογίου\n(Έναρξη/Λήξη)" <<boundary>> as dateRangePicker
rectangle "Επιλογέας Καναλιών Marketing" <<boundary>> as channelSelector
rectangle "Προεπισκόπηση Καμπάνιας" <<boundary>> as campaignPreview
rectangle "Φόρμα Επιβεβαίωσης" <<boundary>> as confirmationForm
rectangle "Μήνυμα Επιτυχίας" <<boundary>> as successMsg
rectangle "Οθόνη Διαθέσιμων Κωδικών\n(για Μέλη)" <<boundary>> as activeCodesDisplay

' Control Objects (Logic)
rectangle "Διαχειριστής Καμπανιών" <<control>> as campaignManager
rectangle "Επικυρωτής Καμπάνιας" <<control>> as campaignValidator
rectangle "Διαχειριστής Κωδικών" <<control>> as promoCodeManager
rectangle "Διαχειριστής Καναλιών" <<control>> as channelManager
rectangle "Υπολογιστής Εκπτώσεων" <<control>> as discountCalculator

' Entity Objects (Data)
rectangle "Καμπάνια" <<entity>> as campaign
rectangle "Κωδικός Προσφοράς" <<entity>> as promoCode
rectangle "Ποσοστό Έκπτωσης" <<entity>> as discountPercentage
rectangle "Περίοδος Ισχύος" <<entity>> as validityPeriod
rectangle "Κανάλι Marketing" <<entity>> as marketingChannel
rectangle "Προϋπολογισμός" <<entity>> as budget
rectangle "Περιγραφή Καμπάνιας" <<entity>> as description

' Ροή 1: Άνοιγμα Φόρμας Καμπάνιας
manager --> campaignDashboard : "1. Ανοίγει\nκαμπάνιες"
manager --> campaignDashboard : "2. Κλικ 'Νέα\nΚαμπάνια'"
campaignDashboard --> campaignForm : "3. Εμφανίζει\nφόρμα"

' Ροή 2: Συμπλήρωση Βασικών Στοιχείων
manager --> campaignForm : "4. Συμπληρώνει:\n- Όνομα\n- Περιγραφή\n- Προϋπολογισμός"
campaignForm --> campaignManager : "5. Αποθηκεύει\nπροσωρινά"

' Ροή 3: Δημιουργία Κωδικού Προσφοράς
manager --> promoCodeGenerator : "6. Εισάγει\nκωδικό\n(π.χ. SPRING2026)"
promoCodeGenerator --> promoCodeManager : "7. Επικύρωση\nμοναδικότητας"
promoCodeManager --> promoCode : "8. Ελέγχει αν\nυπάρχει"
promoCode --> promoCodeManager : "9. Διαθέσιμος"
promoCodeManager --> promoCodeGenerator : "10. Επιτυχία"

' Ροή 4: Ορισμός Έκπτωσης
manager --> campaignForm : "11. Ορίζει\nποσοστό\n(1-100%)"
campaignForm --> discountCalculator : "12. Επικύρωση"
discountCalculator --> discountPercentage : "13. Αποθηκεύει"

' Ροή 5: Επιλογή Περιόδου με Ημερολόγιο
manager --> dateRangePicker : "14. Κλικ στο\nπεδίο ημερομηνίας"
manager --> dateRangePicker : "15. Επιλέγει\nέναρξη"
manager --> dateRangePicker : "16. Επιλέγει\nλήξη"
dateRangePicker --> campaignManager : "17. Αποθηκεύει\nπερίοδο"
campaignManager --> validityPeriod : "18. Δημιουργεί\nπερίοδο"

' Ροή 6: Επιλογή Καναλιών Marketing
manager --> channelSelector : "19. Επιλέγει\nκανάλια"
manager --> channelSelector : "20. Τσεκάρει:\n- In-App\n- Facebook\n- Instagram\n- Email\n- Google Ads"
channelSelector --> channelManager : "21. Αποθηκεύει\nεπιλογές"
channelManager --> marketingChannel : "22. Δημιουργεί\nκανάλια"

' Ροή 7: Προεπισκόπηση Καμπάνιας
manager --> campaignForm : "23. Κλικ\n'Προεπισκόπηση'"
campaignForm --> campaignValidator : "24. Επικύρωση\nπεδίων"
campaignValidator --> campaign : "25. Δημιουργεί\nπρόχειρη καμπάνια"
campaign --> campaignPreview : "26. Εμφανίζει\nοπτική προεπισκόπηση"
campaignPreview --> manager : "27. Προβάλλει:\n- Κωδικό\n- Έκπτωση\n- Περιγραφή\n- Ημερομηνίες\n- Κανάλια"

' Ροή 8: Επιβεβαίωση και Δημοσίευση
manager --> campaignPreview : "28. Επιβεβαιώνει"
campaignPreview --> confirmationForm : "29. Τελική\nεπιβεβαίωση"
manager --> confirmationForm : "30. 'Δημοσίευση'"
confirmationForm --> campaignManager : "31. Αποθηκεύει"
campaignManager --> campaign : "32. Ενεργοποιεί\nκαμπάνια"
campaign --> promoCode : "33. Συνδέει\nκωδικό"
campaign --> description : "34. Αποθηκεύει\nπεριγραφή"
campaign --> budget : "35. Ορίζει\nπροϋπολογισμό"

' Ροή 9: Εμφάνιση στα Μέλη
campaignManager --> activeCodesDisplay : "36. Ενημερώνει\nδιαθέσιμους κωδικούς"
activeCodesDisplay --> member : "37. Εμφανίζει\nστην In-App"
member --> activeCodesDisplay : "38. Βλέπει\nκωδικό στη λίστα"

' Ροή 10: Επιτυχία
campaignManager --> successMsg : "39. Μήνυμα\nεπιτυχίας"
successMsg --> manager : "40. Εμφανίζει\n'Η καμπάνια\nδημοσιεύτηκε'"

@enduml
