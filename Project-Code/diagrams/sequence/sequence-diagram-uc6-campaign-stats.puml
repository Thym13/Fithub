@startuml UC-6: Campaign Performance Tracking

actor "Manager" as Manager

participant "Campaign\nDashboard" as Dashboard
participant "Campaign\nSelector" as CampaignSelector
participant "Stats\nView" as StatsView
participant "Date\nFilter" as DateFilter
participant "Chart\nView" as ChartView
participant "Metrics\nTable" as MetricsTable
participant "Export\nButton" as ExportBtn

database "Campaign\nTable" as CampaignDB
database "Promo Code\nTable" as PromoCodeDB
database "Transaction\nTable" as TransactionDB

Manager -> Dashboard: navigate("/manager#campaigns")
activate Dashboard
Dashboard -> CampaignDB: findAll(select: ['id', 'name', 'budget', 'spent', 'status'])
activate CampaignDB
CampaignDB --> Dashboard: return campaignsList[]
deactivate CampaignDB
Dashboard --> Manager: return renderCampaignsList(campaignsList)
deactivate Dashboard

Manager -> CampaignSelector: onClick(campaignId)
activate CampaignSelector
CampaignSelector -> StatsView: loadCampaignStats(campaignId)
activate StatsView

StatsView -> CampaignDB: findById(campaignId)
activate CampaignDB
CampaignDB --> StatsView: return {name, budget, spent, impressions, clicks, signups, revenue}
deactivate CampaignDB

StatsView -> StatsView: calculateMetrics(campaignDetails)
StatsView -> StatsView: calculateCTR(clicks, impressions)
StatsView -> StatsView: calculateConversionRate(signups, clicks)
StatsView -> StatsView: calculateROI(revenue, spent)

StatsView -> CampaignDB: updateCampaign(campaignId, {roi: calculatedROI})
activate CampaignDB
CampaignDB --> StatsView: return updateSuccess
deactivate CampaignDB

StatsView --> Manager: return renderMetrics({impressions, clicks, signups, revenue, roi})
deactivate StatsView
deactivate CampaignSelector

Manager -> DateFilter: onChange(startDate, endDate)
activate DateFilter
DateFilter -> StatsView: filterByDateRange(startDate, endDate)
activate StatsView
StatsView -> CampaignDB: findById(campaignId, {createdAt: {between: [startDate, endDate]}})
activate CampaignDB
CampaignDB --> StatsView: return filteredData
deactivate CampaignDB

StatsView -> StatsView: recalculateMetrics(filteredData)
StatsView -> ChartView: updateCharts(filteredData)
activate ChartView
ChartView -> ChartView: renderLineChart(revenue_over_time)
ChartView -> ChartView: renderBarChart(signups_per_day)
ChartView --> Manager: return renderCharts()
deactivate ChartView

StatsView -> MetricsTable: updateTable(filteredData)
activate MetricsTable
MetricsTable --> Manager: return renderMetricsTable(filteredData)
deactivate MetricsTable
deactivate StatsView
deactivate DateFilter

Manager -> StatsView: onClick("Promo Code Performance")
activate StatsView
StatsView -> PromoCodeDB: findOne({campaignId})
activate PromoCodeDB
PromoCodeDB --> StatsView: return {code, currentUses, maxUses, discountPercentage}
deactivate PromoCodeDB

StatsView -> TransactionDB: aggregate({promoCodeId}, sum('amount'))
activate TransactionDB
TransactionDB --> StatsView: return revenueFromPromo
deactivate TransactionDB

StatsView -> StatsView: calculateUsagePercentage(currentUses, maxUses)
StatsView --> Manager: return renderPromoStats({uses: currentUses, usagePercent, revenue: revenueFromPromo})
deactivate StatsView

Manager -> ExportBtn: onClick()
activate ExportBtn
ExportBtn -> StatsView: generateReport(campaignId, format: "pdf")
activate StatsView
StatsView -> CampaignDB: findById(campaignId, includeAll: true)
activate CampaignDB
CampaignDB --> StatsView: return fullCampaignData
deactivate CampaignDB

StatsView -> StatsView: generatePDF(fullCampaignData)
StatsView -> StatsView: createFile(reportData)
StatsView --> ExportBtn: return reportFile
deactivate StatsView

ExportBtn --> Manager: download("campaign_report.pdf")
deactivate ExportBtn

@enduml
