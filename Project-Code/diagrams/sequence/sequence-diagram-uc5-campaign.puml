@startuml UC-5: Create Campaign with Promo Code

actor "Manager" as Manager
actor "Member" as Member

participant "Campaign\nDashboard" as Dashboard
participant "Create\nCampaign\nButton" as CreateBtn
participant "Campaign\nForm" as CampaignForm
participant "Promo Code\nGenerator" as PromoGenerator
participant "Date Range\nPicker" as DatePicker
participant "Marketing\nChannels\nSelector" as ChannelSelector
participant "Campaign\nPreview" as Preview
participant "Success\nModal" as SuccessModal
participant "Active Codes\nDisplay" as ActiveCodesView

database "Campaign\nTable" as CampaignDB
database "Promo Code\nTable" as PromoCodeDB
database "Marketing\nChannel\nTable" as ChannelDB
database "Member\nTable" as MemberDB

' Main Flow
Manager -> Dashboard: navigate("/manager#campaigns")
activate Dashboard
Dashboard -> CampaignDB: findAll(orderBy: 'createdAt DESC')
activate CampaignDB
CampaignDB --> Dashboard: return campaignsList[]
deactivate CampaignDB
Dashboard --> Manager: return renderCampaignsDashboard(campaignsList)
deactivate Dashboard

Manager -> CreateBtn: onClick()
activate CreateBtn
CreateBtn -> CampaignForm: openCampaignForm()
activate CampaignForm
CampaignForm -> CampaignForm: setState({showForm: true, step: 1})
CampaignForm --> Manager: return renderCampaignForm()
deactivate CreateBtn
deactivate CampaignForm

Manager -> CampaignForm: onChange(field, value)
activate CampaignForm
loop For each field
    CampaignForm -> CampaignForm: handleInputChange(field, value)
    CampaignForm -> CampaignForm: setFormData({...formData, [field]: value})
end
deactivate CampaignForm

Manager -> PromoGenerator: onClick("Generate")
activate PromoGenerator
PromoGenerator -> PromoGenerator: generateRandomCode()
PromoGenerator -> PromoCodeDB: findOne({code: generatedCode})
activate PromoCodeDB
PromoCodeDB --> PromoGenerator: return existingCode || null
deactivate PromoCodeDB

alt Code already exists
    PromoGenerator --> Manager: return errorMessage("Code already in use. Try another.")
    deactivate PromoGenerator
else Code is unique
    PromoGenerator -> CampaignForm: setPromoCode(code)
    activate CampaignForm
    CampaignForm -> CampaignForm: setFormData({...formData, promoCode: code})
    deactivate CampaignForm
    deactivate PromoGenerator
end

Manager -> PromoGenerator: onChange(discountPercentage)
activate PromoGenerator
PromoGenerator -> CampaignForm: setFormData({...formData, discountPercentage: value})
activate CampaignForm
CampaignForm -> CampaignForm: setState(newFormData)
deactivate CampaignForm
deactivate PromoGenerator

Manager -> DatePicker: onSelect(startDate, endDate)
activate DatePicker
DatePicker -> CampaignForm: handleDateChange(startDate, endDate)
activate CampaignForm
CampaignForm -> CampaignForm: setFormData({...formData, startDate, endDate})
CampaignForm -> CampaignForm: validateDateRange(startDate, endDate)
deactivate CampaignForm
deactivate DatePicker

Manager -> ChannelSelector: onClick()
activate ChannelSelector
ChannelSelector -> ChannelDB: findAll({active: true})
activate ChannelDB
ChannelDB --> ChannelSelector: return channelsList[]
deactivate ChannelDB
ChannelSelector --> Manager: return renderChannels(["Social Media", "Email", "SMS", "Ads"])
deactivate ChannelSelector

Manager -> ChannelSelector: onToggle(channelId)
activate ChannelSelector
loop For each selected channel
    ChannelSelector -> CampaignForm: addChannel(channelId)
    activate CampaignForm
    CampaignForm -> CampaignForm: setFormData({...formData, channels: [...channels, channelId]})
    deactivate CampaignForm
end
deactivate ChannelSelector

Manager -> Preview: onClick("Preview Campaign")
activate Preview
Preview -> CampaignForm: validateAllFields()
activate CampaignForm
CampaignForm -> CampaignForm: checkRequiredFields()
CampaignForm -> CampaignForm: validateBudget()
CampaignForm -> CampaignForm: validateDates()
CampaignForm --> Preview: return validationResult
deactivate CampaignForm

alt Validation failed
    Preview --> Manager: return errorMessage("Please complete all required fields")
    deactivate Preview
else Validation passed
    Preview --> Manager: return renderPreview(campaignData)
    deactivate Preview

    Manager -> Preview: onClick("Create Campaign")
    activate Preview
    Preview -> CampaignDB: createCampaign(name, description, budget, spent: 0, startDate, endDate, createdBy, status: "Active")
    activate CampaignDB
    CampaignDB --> Preview: return campaignId
    deactivate CampaignDB

    Preview -> PromoCodeDB: createPromoCode(campaignId, code, discountPercentage, startDate, expiryDate, maxUses, currentUses: 0, status: "Active")
    activate PromoCodeDB
    PromoCodeDB --> Preview: return promoId
    deactivate PromoCodeDB

    loop For each selected channel
        Preview -> ChannelDB: createCampaignChannel(campaignId, channelId, budgetPercentage)
        activate ChannelDB
        ChannelDB --> Preview: return insertSuccess
        deactivate ChannelDB
    end

    Preview -> ActiveCodesView: publishCode(promoId)
    activate ActiveCodesView
    ActiveCodesView -> PromoCodeDB: updatePromoCode(promoId, {status: 'Active'})
    activate PromoCodeDB
    PromoCodeDB --> ActiveCodesView: return updateSuccess
    deactivate PromoCodeDB
    ActiveCodesView --> Member: return renderPromoCode(promoCodeDetails)
    deactivate ActiveCodesView

    Preview -> SuccessModal: showSuccess(campaignDetails)
    deactivate Preview
    activate SuccessModal
    SuccessModal --> Manager: return renderSuccess(`Campaign created! Promo Code: ${code}`)
    deactivate SuccessModal
end

' Members View Active Codes
group Member Views Promo Codes
    Member -> ActiveCodesView: navigate("/member#membership")
    activate ActiveCodesView
    ActiveCodesView -> PromoCodeDB: findAll({status: 'Active', expiryDate: {gte: NOW()}})
    activate PromoCodeDB
    PromoCodeDB --> ActiveCodesView: return activeCodesList[]
    deactivate PromoCodeDB

    ActiveCodesView -> CampaignDB: findByIds(activeCodesList.campaignId)
    activate CampaignDB
    CampaignDB --> ActiveCodesView: return campaignDetails[]
    deactivate CampaignDB

    ActiveCodesView --> Member: return renderPromoCodes(activeCodesList, campaignDetails)
    deactivate ActiveCodesView
end

@enduml
