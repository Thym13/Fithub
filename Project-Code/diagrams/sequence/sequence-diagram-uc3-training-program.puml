@startuml UC-3: Create Training Program

actor "Trainer" as Trainer

participant "Trainer\nDashboard" as Dashboard
participant "Create\nButton" as CreateBtn
participant "Program\nModal" as ProgramModal
participant "Type\nSelector" as TypeSelector
participant "Details\nForm" as DetailsForm
participant "Target\nSelector" as TargetSelector
participant "Client\nSelector" as ClientSelector
participant "Exercise\nSelector" as ExerciseSelector
participant "Success\nModal" as SuccessModal

database "Training\nProgram\nTable" as ProgramDB
database "Exercise\nTable" as ExerciseDB
database "Client\nTable" as ClientDB
database "Class\nTable" as ClassDB
database "Notification\nTable" as NotificationDB

' Main Flow - Personal Program Creation
Trainer -> Dashboard: navigate("/trainer#programs")
activate Dashboard
Dashboard --> Trainer: return renderProgramsTab()
deactivate Dashboard

Trainer -> CreateBtn: onClick()
activate CreateBtn
CreateBtn -> ProgramModal: handleStartCreation()
activate ProgramModal
ProgramModal -> ProgramModal: setShowCreatePlan(true)
ProgramModal -> ProgramModal: setCreationStep(1)
ProgramModal -> ProgramModal: resetPlanData()
ProgramModal -> TypeSelector: renderStep1()
deactivate CreateBtn
activate TypeSelector
TypeSelector --> Trainer: return renderTypeOptions(["Class", "Workout Program"])
deactivate TypeSelector
deactivate ProgramModal

Trainer -> TypeSelector: onClick("Workout Program")
activate TypeSelector
TypeSelector -> ProgramModal: setPlanType("workout")
activate ProgramModal
ProgramModal -> ProgramModal: setCreationStep(2)
ProgramModal -> DetailsForm: renderStep2()
deactivate TypeSelector
deactivate ProgramModal
activate DetailsForm
DetailsForm --> Trainer: return renderDetailsForm()
deactivate DetailsForm

Trainer -> DetailsForm: onSubmit(formData)
activate DetailsForm
loop For each field
    DetailsForm -> ProgramModal: setPlanData({...planData, [field]: value})
    activate ProgramModal
    ProgramModal -> ProgramModal: setState(newPlanData)
    deactivate ProgramModal
end
deactivate DetailsForm

Trainer -> DetailsForm: onClick("Next Step")
activate DetailsForm
DetailsForm -> ProgramModal: validateDetails()
activate ProgramModal
ProgramModal -> ProgramModal: checkRequiredFields()
alt All fields valid
    ProgramModal -> ProgramModal: setCreationStep(3)
    ProgramModal -> TargetSelector: renderStep3()
    deactivate ProgramModal
    deactivate DetailsForm
    activate TargetSelector
    TargetSelector --> Trainer: return renderTargetOptions(["Group", "Personal"])
    deactivate TargetSelector
else Missing required fields
    ProgramModal --> Trainer: return errorMessage("Please fill all required fields")
    deactivate ProgramModal
    deactivate DetailsForm
end

Trainer -> TargetSelector: onClick("Personal Program")
activate TargetSelector
TargetSelector -> ProgramModal: setTargetType("personal")
activate ProgramModal
ProgramModal -> ProgramModal: setCreationStep(4)
ProgramModal -> ClientSelector: renderStep4Personal()
deactivate TargetSelector
deactivate ProgramModal
activate ClientSelector

ClientSelector -> ClientDB: findAll({trainerId})
activate ClientDB
ClientDB --> ClientSelector: return clientsList[]
deactivate ClientDB
ClientSelector --> Trainer: return renderClientDropdown(clientsList)
deactivate ClientSelector

Trainer -> ClientSelector: onSelect(clientId)
activate ClientSelector
ClientSelector -> ProgramModal: setPlanData({...planData, clientId})
activate ProgramModal
ProgramModal -> ClientDB: findById(clientId)
activate ClientDB
ClientDB --> ProgramModal: return {name, goals, weight, progress}
deactivate ClientDB
ProgramModal --> Trainer: return renderClientPreview(clientDetails)
deactivate ProgramModal
deactivate ClientSelector

Trainer -> ClientSelector: onToggle("progressiveAdjustments")
activate ClientSelector
ClientSelector -> ProgramModal: setPlanData({...planData, progressiveAdjustments: true})
activate ProgramModal
ProgramModal -> ProgramModal: setState(newPlanData)
deactivate ProgramModal
deactivate ClientSelector

Trainer -> ClientSelector: onClick("Next: Add Exercises")
activate ClientSelector
ClientSelector -> ProgramModal: setCreationStep(5)
activate ProgramModal
ProgramModal -> ExerciseSelector: renderStep5()
deactivate ClientSelector
deactivate ProgramModal
activate ExerciseSelector

ExerciseSelector -> ExerciseDB: findAll()
activate ExerciseDB
ExerciseDB --> ExerciseSelector: return exercisesList[]
deactivate ExerciseDB
ExerciseSelector --> Trainer: return renderExerciseDropdown(exercisesList)
deactivate ExerciseSelector

loop Add multiple exercises
    Trainer -> ExerciseSelector: onSelect(exerciseId)
    activate ExerciseSelector
    ExerciseSelector -> ProgramModal: handleAddExercise(exerciseId)
    activate ProgramModal
    ProgramModal -> ExerciseDB: findById(exerciseId)
    activate ExerciseDB
    ExerciseDB --> ProgramModal: return {name, category}
    deactivate ExerciseDB
    ProgramModal -> ProgramModal: setPlanData({...planData, exercises: [...exercises, exercise]})
    ProgramModal --> ExerciseSelector: return exerciseAdded
    deactivate ProgramModal
    deactivate ExerciseSelector

    Trainer -> ExerciseSelector: onChange(exerciseId, field, value)
    activate ExerciseSelector
    ExerciseSelector -> ProgramModal: handleUpdateExercise(exerciseId, field, value)
    activate ProgramModal
    ProgramModal -> ProgramModal: updateExerciseInList(exerciseId, field, value)
    deactivate ProgramModal
    deactivate ExerciseSelector
end

Trainer -> ExerciseSelector: onClick("Create Program")
activate ExerciseSelector
ExerciseSelector -> ProgramModal: handleFinishCreation()
activate ProgramModal
ProgramModal -> ProgramDB: createProgram(name, goal, difficulty, trainerId)
activate ProgramDB
ProgramDB --> ProgramModal: return programId
deactivate ProgramDB

loop For each selected exercise
    ProgramModal -> ProgramDB: createProgramExercise(programId, exerciseId, sets, reps)
    activate ProgramDB
    ProgramDB --> ProgramModal: return insertSuccess
    deactivate ProgramDB
end

ProgramModal -> ClientDB: updateClient(clientId, {currentProgramId: programId})
activate ClientDB
ClientDB --> ProgramModal: return updateSuccess
deactivate ClientDB

ProgramModal -> NotificationDB: createNotification(memberId, type: "new_program", title, content)
activate NotificationDB
NotificationDB --> ProgramModal: return notificationId
deactivate NotificationDB

ProgramModal -> ProgramModal: setShowCreatePlan(false)
ProgramModal -> SuccessModal: setShowSuccessModal(true)
deactivate ProgramModal
deactivate ExerciseSelector
activate SuccessModal
SuccessModal --> Trainer: return renderSuccess("Program created successfully!")
deactivate SuccessModal

' Alternative Flow - Group Program Creation
group Group Program Flow
    participant "Day\nSelector" as DaySelector
    participant "Time\nPicker" as TimePicker
    participant "Capacity\nField" as CapacityField

    Trainer -> TargetSelector: onClick("Group Program")
    activate TargetSelector
    TargetSelector -> ProgramModal: setTargetType("group")
    activate ProgramModal
    ProgramModal -> ProgramModal: setCreationStep(4)
    ProgramModal -> DaySelector: renderStep4Group()
    deactivate TargetSelector
    deactivate ProgramModal
    activate DaySelector
    DaySelector --> Trainer: return renderDayButtons()
    deactivate DaySelector

    Trainer -> DaySelector: onClick(day)
    activate DaySelector
    loop For each day clicked
        DaySelector -> ProgramModal: handleDayToggle(day)
        activate ProgramModal
        ProgramModal -> ProgramModal: toggleDayInArray(day)
        deactivate ProgramModal
    end
    deactivate DaySelector

    Trainer -> TimePicker: onChange(time)
    activate TimePicker
    TimePicker -> ProgramModal: setPlanData({...planData, time})
    activate ProgramModal
    ProgramModal -> ProgramModal: setState(newPlanData)
    deactivate ProgramModal
    deactivate TimePicker

    Trainer -> CapacityField: onChange(capacity)
    activate CapacityField
    CapacityField -> ProgramModal: setPlanData({...planData, capacity})
    activate ProgramModal
    ProgramModal -> ProgramModal: setState(newPlanData)
    deactivate ProgramModal
    deactivate CapacityField

    Trainer -> ExerciseSelector: onClick("Create Program")
    activate ExerciseSelector
    ExerciseSelector -> ProgramModal: handleFinishCreation()
    activate ProgramModal
    ProgramModal -> ProgramDB: createProgram(name, goal, type: "group", trainerId)
    activate ProgramDB
    ProgramDB --> ProgramModal: return programId
    deactivate ProgramDB

    ProgramModal -> ClassDB: createClass(name, programId, days, time, capacity, trainerId)
    activate ClassDB
    ClassDB --> ProgramModal: return classId
    deactivate ClassDB

    ProgramModal -> NotificationDB: notifyAllMembers(type: "new_class", content)
    activate NotificationDB
    loop For each active member
        NotificationDB -> NotificationDB: createNotification(memberId, type, content)
    end
    NotificationDB --> ProgramModal: return allNotificationsCreated
    deactivate NotificationDB

    ProgramModal -> SuccessModal: showSuccess()
    deactivate ProgramModal
    deactivate ExerciseSelector
    activate SuccessModal
    SuccessModal --> Trainer: return renderSuccess("Group class created!")
    deactivate SuccessModal
end

@enduml
