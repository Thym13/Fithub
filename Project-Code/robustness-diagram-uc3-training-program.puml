@startuml Διάγραμμα Ευρωστίας ΠΧ-3: Δημιουργία Προσωπικού Σχεδίου Γυμναστικής

left to right direction

' Actors
actor "Γυμναστής" as trainer

' Boundary Objects
boundary "Επιλογή\nΤύπου\nΠρογράμματος" as typeSelection
boundary "Επιλογή\nΠελάτη/Ομάδας" as clientSelection
boundary "Φόρμα\nΣτόχων" as goalsForm
boundary "Επιλογέας\nΔυσκολίας" as difficultySelector
boundary "Βιβλιοθήκη\nΑσκήσεων" as exerciseLibrary
boundary "Φόρμα\nΆσκησης" as exerciseForm
boundary "Προεπισκόπηση\nΠρογράμματος" as programPreview
boundary "Μήνυμα\nΕπιτυχίας" as successMsg

' Control Objects
control "Διαχειριστής\nΠρογραμμάτων" as programManager
control "Επικυρωτής\nΠρογραμμάτων" as programValidator
control "Διαχειριστής\nΑσκήσεων" as exerciseManager
control "Υπολογιστής\nΔυσκολίας" as difficultyCalculator

' Entity Objects
entity "Πρόγραμμα\nΓυμναστικής" as trainingProgram
entity "Ομαδικό\nΠρόγραμμα" as groupProgram #red
entity "Προσωπικό\nΠρόγραμμα" as personalProgram #red
entity "Άσκηση" as exercise
entity "Σετ\nΆσκησης" as exerciseSet
entity "Πελάτης" as client
entity "Ομάδα" as group #red
entity "Στόχοι" as goals
entity "Δυσκολία" as difficulty

' Main Flow
trainer --> typeSelection
typeSelection --> programManager
trainer --> clientSelection
clientSelection --> programManager
programManager --> client
trainer --> goalsForm
goalsForm --> programManager
programManager --> goals
trainer --> difficultySelector
difficultySelector --> difficultyCalculator
difficultyCalculator --> difficulty
trainer --> exerciseLibrary
exerciseLibrary --> exerciseManager
exerciseManager --> exercise
trainer --> exerciseForm
exerciseForm --> exerciseManager
exerciseManager --> exerciseSet
exerciseManager --> trainingProgram
trainer --> programPreview
programPreview --> programValidator
programValidator --> trainingProgram
programValidator --> successMsg
successMsg --> trainer

' Alternative: Group Program (Red)
programManager -[#red]-> group
programManager -[#red]-> groupProgram

' Alternative: Personal Program (Red)
programManager -[#red]-> personalProgram
programManager -[#red]-> client

@enduml
