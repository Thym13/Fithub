@startuml FitHub Domain Model

' Styling
skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor LightBlue
    BorderColor DarkBlue
    ArrowColor Black
}

' Abstract User Class
abstract class User {
    - userId: String
    - firstName: String
    - lastName: String
    - email: String
    - phone: String
    - password: String
    - role: String
    - accountStatus: String
    - createdDate: Date
    - lastLogin: DateTime
    - emailVerified: Boolean
}

' Specialized User Roles
class GymOwner {
    - numberOfGyms: Integer
    - totalRevenue: Float
}

class Manager {
    - department: String
    - accessLevel: String
    - numberOfEmployees: Integer
}

class Receptionist {
    - shift: String
    - workingHours: Integer
    - numberOfCheckIns: Integer
    - applicationStatus: String
}

class Trainer {
    - specialty: String
    - yearsOfExperience: Integer
    - averageRating: Float
    - certifications: List<String>
    - hourlyRate: Float
    - availability: Map
    - cvDocument: String
    - applicationStatus: String
    - applicationDate: Date
    - numberOfClients: Integer
}

class Member {
    - membershipType: String
    - memberSince: Date
    - expiryDate: Date
    - fitnessGoals: List<String>
    - age: Integer
    - gender: String
    - weight: Float
    - height: Float
    - activityLevel: String
    - medicalHistory: String
    - classPreferences: List<String>
}

' Core Classes
class Membership {
    - membershipId: String
    - type: String
    - monthlyCost: Float
    - durationMonths: Integer
    - startDate: Date
    - expiryDate: Date
    - status: String
    - autoRenewal: Boolean
    - classLimit: Integer
    - ptSessions: Integer
    - spaAccess: Boolean
    - discountPercentage: Float
}

class Class {
    - classId: String
    - name: String
    - category: String
    - description: String
    - dayOfWeek: String
    - time: String
    - durationMinutes: Integer
    - capacity: Integer
    - enrolled: Integer
    - room: String
    - difficultyLevel: String
    - equipmentRequired: List<String>
    - status: String
}

class Booking {
    - bookingId: String
    - bookingDate: Date
    - bookingTime: String
    - status: String
    - createdAt: DateTime
    - cancelledAt: DateTime
    - cancellationReason: String
    - bookingType: String
}

class Waitlist {
    - waitlistId: String
    - position: Integer
    - joinedAt: DateTime
    - status: String
    - notified: Boolean
    - expiryDate: DateTime
}

class TrainingProgram {
    - programId: String
    - name: String
    - goal: String
    - durationWeeks: Integer
    - difficultyLevel: String
    - weeklyFrequency: Integer
    - startDate: Date
    - endDate: Date
    - status: String
    - programType: String
    - instructions: String
}

class Exercise {
    - exerciseId: String
    - name: String
    - category: String
    - description: String
    - muscleGroups: List<String>
    - sets: Integer
    - repetitions: Integer
    - weightKg: Float
    - distanceKm: Float
    - durationMinutes: Integer
    - restSeconds: Integer
    - instructions: String
    - difficultyLevel: String
    - equipment: List<String>
}

class ClientProgress {
    - progressId: String
    - weightKg: Float
    - bodyFatPercentage: Float
    - muscleMassKg: Float
    - waistCircumferenceCm: Float
    - chestCircumferenceCm: Float
    - armCircumferenceCm: Float
    - thighCircumferenceCm: Float
    - measurementDate: Date
    - trainerNotes: String
    - photos: List<String>
}

class Review {
    - reviewId: String
    - rating: Integer
    - comments: String
    - suggestions: String
    - submissionDate: Date
    - status: String
    - rejectionReason: String
    - reviewType: String
}

class SupportTicket {
    - ticketId: String
    - category: String
    - title: String
    - description: String
    - status: String
    - priority: String
    - handlerType: String
    - createdAt: DateTime
    - assignedAt: DateTime
    - resolvedAt: DateTime
    - satisfactionRating: Integer
    - messageCount: Integer
}

class Message {
    - messageId: String
    - sender: String
    - content: String
    - timestamp: DateTime
    - read: Boolean
    - type: String
}

class Payment {
    - transactionId: String
    - amount: Float
    - type: String
    - paymentMethod: String
    - date: Date
    - status: String
    - receipt: String
    - taxPercentage: Float
    - taxAmount: Float
    - totalAmount: Float
}

class Campaign {
    - campaignId: String
    - name: String
    - description: String
    - budget: Float
    - spent: Float
    - startDate: Date
    - endDate: Date
    - status: String
    - impressions: Integer
    - clicks: Integer
    - signups: Integer
    - revenue: Float
    - roi: Float
}

class PromoCode {
    - promoId: String
    - code: String
    - discountPercentage: Integer
    - startDate: Date
    - expiryDate: Date
    - maxUses: Integer
    - currentUses: Integer
    - minimumValue: Float
    - status: String
}

class MarketingChannel {
    - channelId: String
    - name: String
    - type: String
    - budgetPercentage: Float
    - active: Boolean
}

class Task {
    - taskId: String
    - title: String
    - description: String
    - type: String
    - deadline: Date
    - frequency: String
    - status: String
    - priority: String
    - createdAt: DateTime
    - assignedAt: DateTime
    - completedAt: DateTime
    - notes: String
}

class Notification {
    - notificationId: String
    - type: String
    - title: String
    - content: String
    - priority: String
    - read: Boolean
    - channel: String
    - timestamp: DateTime
}

class EmploymentContract {
    - contractId: String
    - position: String
    - monthlySalary: Float
    - workingHours: Integer
    - workingDays: Integer
    - startDate: Date
    - endDate: Date
    - services: List<String>
    - terms: String
    - status: String
    - sentDate: Date
    - responseDate: Date
    - response: String
}

class TrainerApplication {
    - applicationId: String
    - applicationDate: Date
    - status: String
    - cvURL: String
    - certificationsURL: List<String>
    - yearsExperience: Integer
    - specialties: List<String>
    - managerNotes: String
    - reviewDate: Date
}

class Document {
    - documentId: String
    - type: String
    - fileName: String
    - sizeBytes: Integer
    - url: String
    - uploadDate: Date
    - status: String
}

class CheckInRecord {
    - checkInId: String
    - checkInTime: DateTime
    - checkOutTime: DateTime
    - purpose: String
    - membershipVerified: Boolean
}

class Schedule {
    - scheduleId: String
    - week: Integer
    - month: Integer
    - year: Integer
    - operatingHours: Map
}

' Inheritance
User <|-- GymOwner
User <|-- Manager
User <|-- Receptionist
User <|-- Trainer
User <|-- Member

' Composition (black diamond - strong ownership)
Member "1" *-- "1" Membership
TrainingProgram "1" *-- "1*" Exercise
SupportTicket "1" *-- "1*" Message
Campaign "1" *-- "1" PromoCode
TrainerApplication "1" *-- "1*" Document

' Aggregation (white diamond - weak ownership)
Member "1" o-- "0*" Booking
Member "1" o-- "0*" ClientProgress
Member "1" o-- "0*" Review
Member "1" o-- "0*" SupportTicket
Member "1" o-- "0*" Payment
Member "1" o-- "0*" CheckInRecord
Member "1" o-- "0*" Waitlist
Class "1" o-- "0*" Booking
Class "1" o-- "01" Waitlist
Trainer "1" o-- "0*" TrainingProgram
Trainer "1" o-- "0*" ClientProgress
Trainer "1" o-- "0*" EmploymentContract
Trainer "1" o-- "0*" Task
Manager "1" o-- "0*" Task
GymOwner "1" o-- "0*" Task
Receptionist "1" o-- "0*" CheckInRecord
Receptionist "1" o-- "0*" Task
Campaign "1" o-- "1*" MarketingChannel

' Association (simple relationships)
Booking "1" -- "1" Member
Booking "1" -- "1" Class
Waitlist "1" -- "1" Member
Waitlist "1" -- "1" Class
Review "1" -- "1" Member
Review "01" -- "01" Class
Review "01" -- "01" Trainer
Payment "1" -- "1" Member
Payment "01" -- "01" Membership
Payment "01" -- "01" PromoCode
Class "0*" -- "1" Trainer
Class "0*" -- "1" Schedule
TrainingProgram "1" -- "1" Member
Trainer "1" -- "0*" Member
SupportTicket "0*" -- "01" Receptionist
PromoCode "0*" -- "0*" Membership
Task "1" -- "1" Trainer
Task "1" -- "1" Receptionist
Notification "1" -- "1" User
Campaign "0*" -- "1" Manager
Campaign "0*" -- "1" GymOwner
EmploymentContract "0*" -- "1" Manager
EmploymentContract "0*" -- "1" GymOwner
EmploymentContract "1" -- "1" Trainer
TrainerApplication "1" -- "1" Trainer
TrainerApplication "0*" -- "01" Receptionist
TrainerApplication "0*" -- "01" Manager
ClientProgress "1" -- "1" Member
ClientProgress "1" -- "1" Trainer

@enduml
